<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ name }} – {{ role }}</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Segoe UI', system-ui, sans-serif;
      background: #f1f5f9;
      color: #0f172a;
      display: flex;
      min-height: 100vh;
    }

    /* ── SIDEBAR ────────────────────────────────────────────────── */
    .sidebar {
      width: 280px;
      flex-shrink: 0;
      background: linear-gradient(175deg, #0f172a 0%, #1e293b 100%);
      color: #e2e8f0;
      position: sticky;
      top: 0;
      height: 100vh;
      overflow-y: auto;
      padding: 40px 28px;
      display: flex;
      flex-direction: column;
      gap: 28px;
    }

    .sidebar .avatar {
      width: 100px;
      height: 100px;
      border-radius: 50%;
      border: 3px solid #38bdf8;
      display: block;
      margin: 0 auto 16px;
    }

    .sidebar .name {
      font-size: 1.25rem;
      font-weight: 700;
      text-align: center;
      color: #f8fafc;
    }

    .sidebar .role {
      font-size: 0.8rem;
      text-align: center;
      color: #94a3b8;
      margin-top: 4px;
      line-height: 1.5;
    }

    .sidebar .company {
      display: block;
      text-align: center;
      color: #38bdf8;
      font-size: 0.82rem;
      font-weight: 600;
      margin-top: 6px;
    }

    .divider {
      border: none;
      border-top: 1px solid #334155;
    }

    .nav {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .nav a {
      color: #94a3b8;
      text-decoration: none;
      padding: 8px 12px;
      border-radius: 6px;
      font-size: 0.88rem;
      display: flex;
      align-items: center;
      gap: 10px;
      transition: background 0.15s, color 0.15s;
    }

    .nav a:hover,
    .nav a.active {
      background: #1e3a5f;
      color: #38bdf8;
    }

    .social-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .soc-item {
      display: flex;
      align-items: center;
      gap: 10px;
      color: #94a3b8;
      text-decoration: none;
      font-size: 0.84rem;
      transition: color 0.15s;
    }

    .soc-item:hover { color: #38bdf8; }

    .views {
      margin-top: auto;
      text-align: center;
    }

    .views img { max-width: 100%; }

    /* ── MAIN ───────────────────────────────────────────────────── */
    .main {
      flex: 1;
      padding: 40px 48px;
      max-width: 820px;
    }

    .section { margin-bottom: 52px; }

    .section-title {
      font-size: 1.3rem;
      font-weight: 700;
      color: #0f172a;
      margin-bottom: 4px;
    }

    .section-sub {
      color: #64748b;
      font-size: 0.88rem;
      margin-bottom: 20px;
    }

    /* ── FACTS GRID ─────────────────────────────────────────────── */
    .fact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .fact-card {
      background: white;
      border-radius: 12px;
      padding: 18px;
      border: 1px solid #e2e8f0;
      box-shadow: 0 1px 4px rgba(0,0,0,0.04);
    }

    .fact-icon { font-size: 1.4rem; margin-bottom: 6px; }

    .fact-label {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #94a3b8;
      margin-bottom: 3px;
    }

    .fact-value {
      font-size: 0.88rem;
      color: #1e293b;
      font-weight: 500;
    }

    /* ── TECH ───────────────────────────────────────────────────── */
    .tech-section {
      background: white;
      border-radius: 12px;
      padding: 20px;
      border: 1px solid #e2e8f0;
    }

    .tech-row {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      margin-bottom: 14px;
      padding-bottom: 14px;
      border-bottom: 1px solid #f1f5f9;
    }

    .tech-row:last-child {
      margin-bottom: 0;
      padding-bottom: 0;
      border-bottom: none;
    }

    .tech-row-label {
      font-size: 0.78rem;
      font-weight: 600;
      color: #64748b;
      width: 80px;
      flex-shrink: 0;
      padding-top: 4px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .chips { display: flex; flex-wrap: wrap; gap: 6px; }

    .chip {
      background: #f0f9ff;
      color: #0369a1;
      border: 1px solid #bae6fd;
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 0.78rem;
      font-weight: 500;
    }

    /* ── TALKS ──────────────────────────────────────────────────── */
    .talk-card {
      background: white;
      border-radius: 12px;
      padding: 22px;
      border: 1px solid #e2e8f0;
      box-shadow: 0 1px 4px rgba(0,0,0,0.04);
      transition: box-shadow 0.2s, border-color 0.2s;
    }

    .talk-card:hover {
      box-shadow: 0 6px 20px rgba(56,189,248,0.1);
      border-color: #bae6fd;
    }

    .talk-badge {
      display: inline-block;
      background: #eff6ff;
      color: #3b82f6;
      border: 1px solid #bfdbfe;
      padding: 3px 10px;
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: 600;
      margin-bottom: 10px;
    }

    .talk-title {
      font-size: 1rem;
      font-weight: 700;
      color: #0f172a;
      margin-bottom: 8px;
    }

    .talk-desc {
      font-size: 0.87rem;
      color: #64748b;
      line-height: 1.6;
      margin-bottom: 12px;
    }

    .talk-links a {
      color: #3b82f6;
      text-decoration: none;
      font-size: 0.84rem;
      font-weight: 500;
      margin-right: 14px;
    }

    .talk-links a:hover { text-decoration: underline; }

    /* ── STATS ──────────────────────────────────────────────────── */
    .stats-wrap { display: flex; gap: 14px; flex-wrap: wrap; }

    .stats-wrap img {
      border-radius: 10px;
      max-width: 100%;
      border: 1px solid #e2e8f0;
    }

    /* ── FOOTER ─────────────────────────────────────────────────── */
    footer {
      margin-top: 20px;
      padding: 20px 0 10px;
      border-top: 1px solid #e2e8f0;
      color: #94a3b8;
      font-size: 0.82rem;
    }

    footer a { color: #38bdf8; text-decoration: none; }
    footer a:hover { text-decoration: underline; }

    /* ── RESPONSIVE ─────────────────────────────────────────────── */
    @media (max-width: 768px) {
      body { flex-direction: column; }

      .sidebar {
        width: 100%;
        height: auto;
        position: static;
        padding: 28px 24px;
        flex-direction: row;
        flex-wrap: wrap;
        gap: 20px;
        align-items: center;
      }

      .sidebar .profile-block { text-align: center; width: 100%; }

      .nav { flex-direction: row; flex-wrap: wrap; gap: 6px; width: 100%; }

      .social-list { flex-direction: row; flex-wrap: wrap; width: 100%; }

      .views { width: 100%; }

      .main { padding: 28px 20px; }

      .fact-grid { grid-template-columns: 1fr; }

      .stats-wrap img { width: 100% !important; }
    }
  </style>
</head>
<body>

  <!-- ── SIDEBAR ──────────────────────────────────────────────────── -->
  <aside class="sidebar">
    <div class="profile-block">
      <img
        class="avatar"
        src="{{ avatar_url }}"
        alt="{{ name }}"
      />
      <div class="name">{{ name }}</div>
      <div class="role">{{ role }}</div>
      <span class="company">@ {{ company.name }}</span>
    </div>

    <hr class="divider" />

    <nav class="nav">
      <a href="#about" class="active">👤 About</a>
      <a href="#tech">💻 Technologies</a>
      <a href="#talks">🎤 Talks</a>
      <a href="#stats">📈 Activity</a>
    </nav>

    <hr class="divider" />

    <div class="social-list">
      {% for s in social if s.show_html -%}
      <a class="soc-item" href="{{ s.url }}" target="_blank" rel="noopener">
        {{ s.html_icon }} {{ s.html_display }}
      </a>
      {% endfor %}
    </div>

    <div class="views">
      <img
        src="{{ profile_views_url | replace('3498db', '38bdf8') }}"
        alt="Profile Views"
      />
    </div>
  </aside>

  <!-- ── MAIN ─────────────────────────────────────────────────────── -->
  <main class="main">

    <section class="section" id="about">
      <div class="section-title">Hey, I'm {{ name.split()[0] }} 👋</div>
      <div class="section-sub">
        Building scalable cloud-native systems and exploring how AI can augment engineering workflows.
      </div>
      <div class="fact-grid">
        {% for f in quick_facts -%}
        <div class="fact-card">
          <div class="fact-icon">{{ f.icon }}</div>
          <div class="fact-label">{{ f.label }}</div>
          <div class="fact-value">{{ f.value }}</div>
        </div>
        {% endfor %}
      </div>
    </section>

    <section class="section" id="tech">
      <div class="section-title">Technologies &amp; Tools</div>
      <div class="section-sub">Languages, cloud platforms, and tools I work with daily.</div>
      <div class="tech-section">
        {% for group in technologies -%}
        <div class="tech-row">
          <div class="tech-row-label">{{ group.html_label }}</div>
          <div class="chips">
            {% for item in group.tech -%}
            <span class="chip">{{ item.name }}</span>
            {% endfor %}
          </div>
        </div>
        {% endfor %}
      </div>
    </section>

    <section class="section" id="talks">
      <div class="section-title">Presentations</div>
      <div class="section-sub">Conference talks and presentations.</div>
      {% for talk in presentations -%}
      <div class="talk-card">
        <div class="talk-badge">{{ talk.event }} · {{ talk.date }}</div>
        <div class="talk-title">{{ talk.title }}</div>
        <div class="talk-desc">
          {{ talk.description }}
        </div>
        <div class="talk-links">
          <a href="{{ talk.video_url }}" target="_blank" rel="noopener">📹 Video</a>
          <a href="{{ talk.slides_path }}">📊 Slides</a>
        </div>
      </div>
      {% endfor %}
    </section>

    <section class="section" id="stats">
      <div class="section-title">GitHub Activity</div>
      <div class="section-sub">Commits, streaks, and contributions.</div>
      <div class="stats-wrap">
        <picture>
          <source
            media="(prefers-color-scheme: dark)"
            srcset="{{ stats.stats_url_dark }}"
          />
          <img
            src="{{ stats.stats_url_light }}"
            style="width: 48%"
            alt="GitHub Stats"
          />
        </picture>
        <picture>
          <source
            media="(prefers-color-scheme: dark)"
            srcset="{{ stats.streak_url_dark }}"
          />
          <img
            src="{{ stats.streak_url_light }}"
            style="width: 48%"
            alt="GitHub Streak"
          />
        </picture>
      </div>
    </section>

    <footer>
      💬 {{ footer_message }} &nbsp;·&nbsp;
      {% for s in social if s.show_html and s.platform != 'GitHub' -%}
      <a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.platform }}</a>{% if not loop.last %} &nbsp;·&nbsp; {% endif %}
      {% endfor %}
    </footer>

  </main>

</body>
</html>
